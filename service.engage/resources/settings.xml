<?xml version="1.0" encoding="UTF-8"?>
<!--
  <summary>
  Kodi settings definition for the add-on: one General category holding the
  read-only version field, the Manage slots action button, debug logging, the
  poll interval, the catch-up window and its prompt cap, the recent watch
  window, the master banner style, the switch that shows a Full Monty banner
  as Uber thin over playback, the Coming up countdown and its minutes, the
  one-shot test mode, the favourites filter
  switch, the switch for the add-on API that the JellyStat dashboard uses, and
  the hidden sort order of the Manage slots window.
  Labels are plain text; the add-on ships no strings.po.
  </summary>
-->
<settings>

  <category label="General">
    <!-- Read-only. The service writes the running add-on version into this on
         start-up (see service.py), so it never has to be kept in step by hand. -->
    <setting id="version_info" type="text" label="Version" default="" enable="false"/>
    <setting type="sep"/>
    <setting label="Manage slots..." type="action" action="RunScript(special://home/addons/service.engage/script.py,manage_slots)" option="close"/>
    <setting type="sep"/>
    <!-- Hidden. The order the Manage slots window last sorted by, one of the
         ids in SORTS in resources/lib/slots_window.py. -->
    <setting id="slots_sort" type="text" label="Slots sort" default="next" visible="false"/>
    <setting id="debug" type="bool" label="Enable debug logging" default="false"/>
    <setting id="poll_interval" type="slider" label="Poll interval (seconds)" default="30" range="5,5,120" option="int"/>
    <setting id="catchup_hours" type="slider" label="Catch-up window for missed slots (hours, 0 = off)" default="6" range="0,1,12" option="int"/>
    <setting id="catchup_max_prompts" type="slider" label="Max times to show a missed-slot banner" default="3" range="1,1,10" option="int"/>
    <setting id="recent_watch_hours" type="slider" label="Skip a slot watched in the last (hours, 0 = off)" default="4" range="0,1,24" option="int"/>
    <!-- The banner layout every slot uses unless it picks its own in Manage
         slots. An enum stores the index of the chosen value, so the order here
         must match BANNER_STYLE_SETTING_ORDER in resources/lib/slots.py:
         0 = Standard (the original banner), 1 = Thin, 2 = Uber thin,
         3 = Uber thin with no buttons, 4 = Full Monty. New styles go on
         the end only. -->
    <setting id="banner_style" type="enum" label="Default banner style" values="Standard|Thin|Uber thin|Uber thin, no buttons|Full Monty" default="0"/>
    <!-- Off by default. When on, a banner that would open as the Full Monty
         opens as Uber thin instead while something is already playing, so a
         slot that follows straight on from another does not cover the screen.
         Read at popup time by slots.fullmonty_over_playback_setting. -->
    <setting id="fullmonty_over_playback_uberthin" type="bool" label="Show a Full Monty banner as Uber thin over playback" default="false"/>
    <!-- Off by default. When on, the slot that plays next counts down for the
         last next_countdown_minutes before it starts, published as
         Engage.Next.Countdown and Engage.Next.CountdownPercent for a skin's
         Coming up list. One switch for every slot. -->
    <setting id="next_countdown" type="bool" label="Count down to the next slot in Coming up" default="false"/>
    <setting id="next_countdown_minutes" type="slider" label="Start the countdown this many minutes before" default="30" range="5,5,120" option="int" enable="eq(-1,true)"/>
    <setting id="test_mode" type="bool" label="Test mode (trigger all enabled slots immediately)" default="false"/>
    <setting id="show_all_favourites" type="bool" label="Show all favourites in pickers (off = video/TV only)" default="false"/>
    <!-- Starts Engage's add-on API (resources/lib/api_server.py), which listens on
         this Kodi only and lets the JellyStat dashboard manage slots. -->
    <setting id="api_enabled" type="bool" label="Allow JellyStat to manage slots" default="true"/>
  </category>

</settings>
