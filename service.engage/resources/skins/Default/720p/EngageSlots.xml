<?xml version="1.0" encoding="UTF-8"?>
<!--
  <summary>
  The full screen Manage slots window: every slot as a row with its name, what
  it plays, when it runs and when it is next due, under a Sort button, an Add
  slot button and a Backup / Restore button.
  </summary>
  <remarks>
  Driven by resources/lib/slots_window.py (SlotsWindow), which fills list 500
  and the window properties: heading, sortlabel and count. Each row's ListItem
  carries its name as the label, the next due words as label2, and the
  properties kind, schedule and enabled ('true' or 'false'). Choosing a row
  opens the existing edit menu; the buttons open the existing add and backup
  menus. Added 22/10/2026 (SLOTS-WINDOW). Opaque, so it reads as full screen
  over any skin. Fonts are ones both Estuary and the Functional skin define,
  as in the banners.
  </remarks>
-->
<window type="dialog">
    <defaultcontrol always="true">500</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>

        <!-- Background, opaque -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1280</width>
            <height>720</height>
            <texture colordiffuse="FF0E0E1A">white.png</texture>
        </control>

        <!-- Heading -->
        <control type="label">
            <left>40</left>
            <top>24</top>
            <width>400</width>
            <height>20</height>
            <font>font12</font>
            <textcolor>FF00BCD4</textcolor>
            <label>$INFO[Window.Property(heading)]</label>
        </control>
        <control type="label">
            <left>40</left>
            <top>44</top>
            <width>520</width>
            <height>50</height>
            <font>font32_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>Slots</label>
        </control>

        <!-- Buttons, top right: Sort, Add slot, Backup / Restore -->
        <control type="grouplist" id="9000">
            <left>560</left>
            <top>40</top>
            <width>680</width>
            <height>48</height>
            <orientation>horizontal</orientation>
            <align>right</align>
            <itemgap>12</itemgap>
            <ondown>500</ondown>
            <control type="button" id="9001">
                <width>250</width>
                <height>48</height>
                <font>font12</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFDDDDDD</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus colordiffuse="FF00BCD4">white.png</texturefocus>
                <texturenofocus colordiffuse="FF262640">white.png</texturenofocus>
                <label>Sort: $INFO[Window.Property(sortlabel)]</label>
            </control>
            <control type="button" id="9002">
                <width>170</width>
                <height>48</height>
                <font>font12</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFDDDDDD</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus colordiffuse="FF00BCD4">white.png</texturefocus>
                <texturenofocus colordiffuse="FF262640">white.png</texturenofocus>
                <label>Add slot</label>
            </control>
            <control type="button" id="9003">
                <width>220</width>
                <height>48</height>
                <font>font12</font>
                <align>center</align>
                <aligny>center</aligny>
                <textcolor>FFDDDDDD</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus colordiffuse="FF00BCD4">white.png</texturefocus>
                <texturenofocus colordiffuse="FF262640">white.png</texturenofocus>
                <label>Backup / Restore</label>
            </control>
        </control>

        <!-- Column headings -->
        <control type="label">
            <left>60</left>
            <top>108</top>
            <width>440</width>
            <height>24</height>
            <font>font12</font>
            <textcolor>FF8A8AA0</textcolor>
            <label>SLOT</label>
        </control>
        <control type="label">
            <left>560</left>
            <top>108</top>
            <width>360</width>
            <height>24</height>
            <font>font12</font>
            <textcolor>FF8A8AA0</textcolor>
            <label>RUNS</label>
        </control>
        <control type="label">
            <left>940</left>
            <top>108</top>
            <width>280</width>
            <height>24</height>
            <font>font12</font>
            <textcolor>FF8A8AA0</textcolor>
            <align>right</align>
            <label>NEXT</label>
        </control>
        <control type="image">
            <left>40</left>
            <top>136</top>
            <width>1200</width>
            <height>2</height>
            <texture colordiffuse="FF00BCD4">white.png</texture>
        </control>

        <!-- The slots: name with what it plays beneath, when it runs, when next -->
        <control type="list" id="500">
            <left>40</left>
            <top>146</top>
            <width>1200</width>
            <height>520</height>
            <onup>9000</onup>
            <ondown>500</ondown>
            <scrolltime>150</scrolltime>
            <itemlayout height="65">
                <control type="label">
                    <left>20</left>
                    <top>6</top>
                    <width>480</width>
                    <height>28</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>6</top>
                    <width>480</width>
                    <height>28</height>
                    <font>font13</font>
                    <textcolor>FF6A6A80</textcolor>
                    <label>$INFO[ListItem.Label]  (disabled)</label>
                    <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>34</top>
                    <width>480</width>
                    <height>24</height>
                    <font>font12</font>
                    <textcolor>FF8A8AA0</textcolor>
                    <label>$INFO[ListItem.Property(kind)]</label>
                </control>
                <control type="label">
                    <left>520</left>
                    <top>0</top>
                    <width>360</width>
                    <height>64</height>
                    <font>font12</font>
                    <aligny>center</aligny>
                    <textcolor>FFDDDDDD</textcolor>
                    <label>$INFO[ListItem.Property(schedule)]</label>
                </control>
                <control type="label">
                    <left>900</left>
                    <top>0</top>
                    <width>280</width>
                    <height>64</height>
                    <font>font12</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FFDDDDDD</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>64</top>
                    <width>1200</width>
                    <height>1</height>
                    <texture colordiffuse="FF262640">white.png</texture>
                </control>
            </itemlayout>
            <focusedlayout height="65">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1200</width>
                    <height>64</height>
                    <texture colordiffuse="FF1E2A44">white.png</texture>
                    <visible>!Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1200</width>
                    <height>64</height>
                    <texture colordiffuse="FF00BCD4">white.png</texture>
                    <visible>Control.HasFocus(500)</visible>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>6</top>
                    <width>480</width>
                    <height>28</height>
                    <font>font13</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>String.IsEqual(ListItem.Property(enabled),true)</visible>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>6</top>
                    <width>480</width>
                    <height>28</height>
                    <font>font13</font>
                    <textcolor>FFC8C8D8</textcolor>
                    <label>$INFO[ListItem.Label]  (disabled)</label>
                    <visible>!String.IsEqual(ListItem.Property(enabled),true)</visible>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>34</top>
                    <width>480</width>
                    <height>24</height>
                    <font>font12</font>
                    <textcolor>FFE8F8FA</textcolor>
                    <label>$INFO[ListItem.Property(kind)]</label>
                </control>
                <control type="label">
                    <left>520</left>
                    <top>0</top>
                    <width>360</width>
                    <height>64</height>
                    <font>font12</font>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Property(schedule)]</label>
                </control>
                <control type="label">
                    <left>900</left>
                    <top>0</top>
                    <width>280</width>
                    <height>64</height>
                    <font>font12</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Nothing yet -->
        <control type="label">
            <left>60</left>
            <top>180</top>
            <width>1160</width>
            <height>40</height>
            <font>font13</font>
            <textcolor>FF8A8AA0</textcolor>
            <label>No slots yet. Choose Add slot to make one.</label>
            <visible>Integer.IsEqual(Container(500).NumItems,0)</visible>
        </control>

        <!-- Footer: how many, and where the focus is -->
        <control type="label">
            <left>40</left>
            <top>676</top>
            <width>1200</width>
            <height>24</height>
            <font>font12</font>
            <textcolor>FF8A8AA0</textcolor>
            <align>right</align>
            <label>$INFO[Container(500).CurrentItem,, of ]$INFO[Window.Property(count)]</label>
            <visible>!Integer.IsEqual(Container(500).NumItems,0)</visible>
        </control>

    </controls>
</window>
