<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.engage"
       name="Engage"
       version="1.10.0"
       provider-name="c0def0rc0ffee">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.python.script" library="script.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Personal watch schedule prompts for Kodi.</summary>
    <description lang="en">A lightweight scheduler that lets you define custom weekly watch slots for TV shows, movies, folders, playlists, or favourites. Get prompted before your scheduled time and optionally auto-open the selected Kodi favourite.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="repository.engage"
       name="Engage Repository"
       version="1.0.0"
       provider-name="c0def0rc0ffee">
  <extension point="xbmc.addon.repository" name="Engage Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/c0def0rc0ffee/Engage/repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/c0def0rc0ffee/Engage/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/c0def0rc0ffee/Engage/repo/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Installs Engage and keeps it updated</summary>
    <description>Add this repository once and Kodi updates Engage automatically whenever a new version is released.</description>
    <platform>all</platform>
  </extension>
</addon>
</addons>
