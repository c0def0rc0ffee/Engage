# Secrets, both cases because matching is case sensitive. Nothing secret
# lives in this tree; the patterns stop one being added by accident.
.env
.env.*
*credential*
*CREDENTIAL*
*Credential*
*password*
*PASSWORD*
*Password*
*secret*
*SECRET*
*Secret*
*token*
*TOKEN*
*Token*
*cred*
*CRED*
*sftp*
*SFTP*
*ftp*
*FTP*
*.pem
*.key
*.pfx
id_rsa*
connection.txt
*config.local*
*.bak

# Dev only files inside the add-on folder, dropped from both zips by build-zip.sh
/service.engage/**/test.py
/service.engage/**/*_test.py
/service.engage/**/test_*.py
